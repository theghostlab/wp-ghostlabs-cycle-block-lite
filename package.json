{
  "name": "ghostlabs-cycle-block-lite",
  "version": "1.1.0",
  "description": "Cycle Block \u2014 Gutenberg container block whose nested variations rotate on a schedule.",
  "author": "Ghost Labs",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "build": "pnpm run build:blocks && pnpm run build:esbuild && pnpm run build:tailwind",
    "build:blocks": "wp-scripts build --config webpack.config.cjs",
    "build:esbuild": "cross-env NODE_ENV=production node esbuild.mjs --bundle",
    "build:tailwind": "cross-env NODE_ENV=production tailwindcss -i ./dev/tailwind/settings.src.css -o ./assets/css/settings.css --minify",
    "build:clean": "rm -rf build/blocks assets/js assets/css/settings.css",
    "start": "wp-scripts start --config webpack.config.cjs",
    "watch:js": "node esbuild.mjs --watch",
    "watch:css": "tailwindcss -i ./dev/tailwind/settings.src.css -o ./assets/css/settings.css --watch",
    "watch": "npm-run-all --parallel watch:*",
    "test": "pnpm run test:unit",
    "test:unit": "vendor/bin/phpunit --testsuite unit",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "wp-env:start": "npm-run-all wp-env:start:dev wp-env:start:tests",
    "wp-env:start:dev": "wp-env start",
    "wp-env:start:tests": "wp-env start --config .wp-env.tests.json",
    "wp-env:stop": "npm-run-all --continue-on-error wp-env:stop:dev wp-env:stop:tests",
    "wp-env:stop:dev": "wp-env stop",
    "wp-env:stop:tests": "wp-env stop --config .wp-env.tests.json",
    "wp-env:destroy:dev": "wp-env destroy",
    "wp-env:destroy:tests": "wp-env destroy --config .wp-env.tests.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/typography": "^0.5.10",
    "@wordpress/e2e-test-utils-playwright": "^1.15.0",
    "@wordpress/env": "^11.12.0",
    "@wordpress/icons": "^9.32.0",
    "@wordpress/scripts": "^26.12.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.23.1",
    "npm-run-all": "^4.1.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.3.3"
  },
  "dependencies": {
    "@wordpress/components": "^25.16.0",
    "@wordpress/element": "^5.35.0",
    "@wordpress/i18n": "^6.25.0",
    "@xstate/react": "^6.1.0",
    "ulid": "^2.3.0",
    "xstate": "^5.18.1"
  }
}
