# Resolve the @theghostlab scope from GitHub Packages.
@theghostlab:registry=https://npm.pkg.github.com

# The auth token deliberately does NOT live here. pnpm 11+ refuses to expand
# environment variables in registry credentials that come from a committed
# project .npmrc, so a `_authToken=${GITHUB_TOKEN}` line would be ignored with a
# warning on every command. Put it in your user-level ~/.npmrc instead:
#
#   pnpm config set "//npm.pkg.github.com/:_authToken" "$GITHUB_TOKEN"
#
# CI writes the same line to ~/.npmrc before `pnpm install`.
